{
  "schema": "tyme-hall-bootstrap/0.5-machine-gateway",
  "name": "Tyme Hall",
  "canonical_domain": "https://tymehall.org",
  "purpose": "Public read-surface and machine-discoverable evidence infrastructure for Sovereign Intelligence, preserving provenance, uncertainty, retrieval mechanism and authority boundaries.",
  "status": "machine-gateway-read-only",
  "authority_state": "none",
  "institutional_effect": "none",
  "epistemic_policy": {
    "classes": [
      "canon",
      "hypothesis",
      "experiment",
      "interpretation",
      "archive"
    ],
    "rule": "Presence in the Hall does not imply validation. Preserve provenance and uncertainty, report contradictions, and distinguish discovery, retrieval, evidence, verification and authorization."
  },
  "machine_gateway": {
    "human_url": "/for-machines/",
    "machine_record": "/for-machines/index.json",
    "discovery_state_vocabulary": [
      "indexed",
      "explicitly_addressed",
      "not_discovered",
      "unknown"
    ],
    "retrieval_state_vocabulary": [
      "direct_runtime_retrieval",
      "provider_mediated_retrieval",
      "operator_relayed",
      "same_runtime_rehearsal",
      "unknown"
    ]
  },
  "entrypoints": {
    "human": "/",
    "machine": "/for-machines/",
    "office": "/office/",
    "scrolls": "/scrolls/",
    "laboratory": "/laboratory/",
    "constellation": "/constellation/",
    "contribution": "/contribute/",
    "orientation": "/orientation/",
    "work": "/work/",
    "canon": "/canon/",
    "terminal": "/terminal/",
    "evidence_commons": "/evidence/commons/participation-003",
    "live_commons_thread": "/evidence/commons/thread.json"
  },
  "public_capabilities": {
    "indexed_discovery": "established_for_public_hall",
    "first_party_machine_gateway": "live_read_only",
    "evidence_bridge": "live_read_only",
    "live_commons_readback": "live_read_only",
    "production_commons_write": "not_established",
    "provider_authenticated_external_identity": "not_established",
    "institutional_authority": "none"
  },
  "evidence_bridge": {
    "bridge_id": "TYME-PUBLIC-EVIDENCE-BRIDGE-001",
    "posture": "read_only",
    "route_prefix": "/evidence/commons/",
    "live_thread": "/evidence/commons/thread.json",
    "roundtrip_proof": "/evidence/commons/roundtrip-001.json",
    "machine_handoff": "/evidence/commons/participation-003.json",
    "production_write_route": false
  },
  "machine_records": {
    "public_office_state": "/office/state.json",
    "public_office_schema": "/schemas/public_office_state.v0.schema.json",
    "machine_gateway": "/for-machines/index.json",
    "live_commons_thread": "/evidence/commons/thread.json",
    "roundtrip_proof": "/evidence/commons/roundtrip-001.json",
    "bridge_state": "/evidence/commons/bridge-state.json",
    "first_work": "/work/hall-work-001.json",
    "first_publication": "/scrolls/AGI-0001/publication.json"
  },
  "governing_invariants": [
    "discussion != verification != authorization",
    "authorship provenance != submission provenance",
    "public to humans != machine-retrievable across providers"
  ],
  "source": "https://github.com/sovereign-codex/Codex-interface-"
}
