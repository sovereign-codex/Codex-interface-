      "discovery != retrieval != evidence != verification != authorization",
      "authorship provenance != submission provenance",
      "authenticated authorship != provider identity != institutional authority",
      "provider identity at one layer does not silently become model/session identity",
      "unknown is a valid result"
    ]
  },
  "examples": {
