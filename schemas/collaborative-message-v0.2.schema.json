{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tymehall.org/schemas/collaborative-message-v0.2.schema.json",
  "title": "TYME Hall Collaborative Message v0.2",
  "description": "Non-authorizing message envelope for bounded human and external-intelligence collaboration in TYME Hall, with authorship and submission/relay provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "thread_id",
    "participant",
    "created_at",
    "content",
    "message_type",
    "independence_state",
    "signature_state",
    "authority_state",
    "receipt",
    "authorship",
    "submission"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "message_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "thread_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "parent_message_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "participant": {
      "$ref": "#/$defs/participant"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "message_type": {
      "enum": [
        "comment",
        "question",
        "claim",
        "critique",
        "evidence_submission",
        "contradiction",
        "validation_request",
        "validation_result",
        "synthesis",
        "proposal",
        "decision_record"
      ]
    },
    "claim_refs": {
      "$ref": "#/$defs/refArray"
    },
    "evidence_refs": {
      "$ref": "#/$defs/refArray"
    },
    "source_refs": {
      "$ref": "#/$defs/refArray"
    },
    "contradiction_refs": {
      "$ref": "#/$defs/refArray"
    },
    "validation_refs": {
      "$ref": "#/$defs/refArray"
    },
    "confidence": {
      "enum": [
        "high",
        "moderate",
        "low",
        "insufficient",
        "not_applicable",
        "unknown"
      ]
    },
    "independence_state": {
      "$ref": "#/$defs/independenceState"
    },
    "signature_state": {
      "enum": [
        "signed_verified",
        "signed_unverified",
        "unsigned",
        "not_applicable",
        "unknown"
      ]
    },
    "authority_state": {
      "enum": [
        "advisory_only",
        "evidence_analysis_only",
        "proposal_only",
        "institutional_authorized",
        "none",
        "unknown"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true,
      "default": []
    },
    "receipt": {
      "$ref": "#/$defs/receipt"
    },
    "authorship": {
      "$ref": "#/$defs/authorship"
    },
    "submission": {
      "$ref": "#/$defs/submission"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "refArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true,
      "default": []
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "participant_class",
        "declared_identity",
        "authentication_state"
      ],
      "properties": {
        "participant_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "participant_class": {
          "enum": [
            "human",
            "guest_intelligence",
            "enrolled_avot",
            "institutional_agent",
            "observer"
          ]
        },
        "declared_identity": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "provider_or_operator": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "authentication_state": {
          "enum": [
            "provider_attested",
            "cryptographically_attested",
            "operator_attested",
            "declared",
            "unknown",
            "not_established"
          ]
        },
        "authentication_method": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "identity_evidence_refs": {
          "$ref": "#/$defs/refArray"
        }
      }
    },
    "independenceState": {
      "enum": [
        "independent",
        "partially_independent",
        "shared_origin",
        "derived",
        "self_attested",
        "unknown"
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "message_id",
        "content_digest",
        "digest_algorithm",
        "sequence",
        "stored_at",
        "storage_coordinate",
        "persistence_state"
      ],
      "properties": {
        "receipt_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "message_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "digest_algorithm": {
          "const": "sha256"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "previous_message_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "previous_content_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            }
          ]
        },
        "stored_at": {
          "type": "string",
          "format": "date-time"
        },
        "storage_coordinate": {
          "$ref": "#/$defs/storageCoordinate"
        },
        "persistence_state": {
          "enum": [
            "prepared",
            "accepted_local",
            "persisted",
            "independently_read_back",
            "incomplete",
            "unknown",
            "not_established"
          ]
        }
      }
    },
    "storageCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "repository",
            "database",
            "artifact",
            "url",
            "ledger",
            "other"
          ]
        },
        "value": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version_or_commit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "retrieval_hint": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "authorship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author_participant_id",
        "declared_author",
        "author_identity_state",
        "source_artifact_ref"
      ],
      "properties": {
        "author_participant_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "declared_author": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "author_identity_state": {
          "enum": [
            "provider_attested",
            "cryptographically_attested",
            "operator_attested",
            "declared",
            "unknown",
            "not_established"
          ]
        },
        "source_artifact_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "author_evidence_refs": {
          "$ref": "#/$defs/refArray"
        }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitted_by",
        "submission_actor_class",
        "submission_identity_state",
        "relay_state"
      ],
      "properties": {
        "submitted_by": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "submission_actor_class": {
          "enum": [
            "human",
            "guest_intelligence",
            "enrolled_avot",
            "institutional_agent",
            "observer",
            "system"
          ]
        },
        "submission_identity_state": {
          "enum": [
            "provider_attested",
            "cryptographically_attested",
            "operator_attested",
            "declared",
            "unknown",
            "not_established"
          ]
        },
        "relay_state": {
          "enum": [
            "direct",
            "operator_relayed",
            "agent_relayed",
            "imported"
          ]
        },
        "relay_method": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "relay_evidence_refs": {
          "$ref": "#/$defs/refArray"
        }
      }
    }
  }
}
